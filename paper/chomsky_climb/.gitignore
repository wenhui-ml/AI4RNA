*.aux
*.log
*.blg
*.bbl
*.out
*.toc
*.fls
*.fdb_latexmk
# TikZ standalone intermediates -- the single source is tikz/*.tex, the single output is figs/*.pdf
tikz/*.pdf
tikz/*.aux
tikz/*.log
# Python figure caches
__pycache__/
