\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Controlled Goodhart (RNA, $18$ targets $\times \,5$ seeds $=90$ units/cell; bootstrap $95\%$ CI). In the cheap arm the \emph  {proxy} (exact-match) rises to $70\%$ while its \emph  {robustness} peaks then falls to $15.6\%$---the proxy--objective divergence that defines Goodhart. The strong arm (control) improves both. Raw numerators are $\text  {rate}\times 90$.}}{18}{table.caption.33}\protected@file@percent }
\newlabel{tab:goodhart}{{10}{18}{Controlled Goodhart (RNA, $18$ targets $\times \,5$ seeds $=90$ units/cell; bootstrap $95\%$ CI). In the cheap arm the \emph {proxy} (exact-match) rises to $70\%$ while its \emph {robustness} peaks then falls to $15.6\%$---the proxy--objective divergence that defines Goodhart. The strong arm (control) improves both. Raw numerators are $\text {rate}\times 90$}{table.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Controlled Goodhart (RNA, fixed proposer, $18$ targets $\times \,5$ seeds). Within the cheap arm, the \emph  {proxy} it optimizes (exact-match, dashed) rises to $70\%$ while its \emph  {robustness} (red) fails to follow (peaking then falling below its start); the strong-arm control (green) improves robustness monotonically. The load-bearing result is the arm\,$\times $\,budget interaction (DiD $+23.3$ pts, permutation $p{=}0.0002$), not the marginal within-cheap decline.}}{19}{figure.caption.34}\protected@file@percent }
\newlabel{fig:goodhart}{{7}{19}{Controlled Goodhart (RNA, fixed proposer, $18$ targets $\times \,5$ seeds). Within the cheap arm, the \emph {proxy} it optimizes (exact-match, dashed) rises to $70\%$ while its \emph {robustness} (red) fails to follow (peaking then falling below its start); the strong-arm control (green) improves robustness monotonically. The load-bearing result is the arm\,$\times $\,budget interaction (DiD $+23.3$ pts, permutation $p{=}0.0002$), not the marginal within-cheap decline}{figure.caption.34}{}}
