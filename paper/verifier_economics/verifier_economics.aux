\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces LLM code verifier over-acceptance on \textsc  {HumanEval+} ($163$ problems, $12$ samples/problem, two open-weights proposers), scored on \emph  {held-out gold} tests with no exact test-case reuse under a \emph  {fixed} seed-$0$ split (plus tests split into a tuning half for the strong arm's selection and a gold half for evaluation). Over-acceptance at the weakest cheap rung (a single base test) is reported both as the joint mass $\Pr [\text  {pass cheap}\wedge \text  {fail gold}]$ and the conditional rate $\Pr [\text  {fail gold}\mid \text  {pass cheap}]$, each with a count $x/y$ and a problem-clustered bootstrap $95\%$ CI; both are stable across split seeds (conditional: llama $28.4/26.6/26.5/25.6$, Qwen $2.4/2.5/2.4/2.8$). The weaker proposer over-accepts an order of magnitude more than the stronger. The last column is the best-of-$12$ gold robustness of the cheap- vs.\ strong-selected candidate: the strong arm's advantage is a null ($+0.0$/$+0.6$). Run with all completions, prompts, seeds, and sandbox diagnostics saved ($0$ extraction failures).}}{23}{table.caption.44}\protected@file@percent }
\newlabel{tab:llm}{{11}{23}{LLM code verifier over-acceptance on \textsc {HumanEval+} ($163$ problems, $12$ samples/problem, two open-weights proposers), scored on \emph {held-out gold} tests with no exact test-case reuse under a \emph {fixed} seed-$0$ split (plus tests split into a tuning half for the strong arm's selection and a gold half for evaluation). Over-acceptance at the weakest cheap rung (a single base test) is reported both as the joint mass $\Pr [\text {pass cheap}\wedge \text {fail gold}]$ and the conditional rate $\Pr [\text {fail gold}\mid \text {pass cheap}]$, each with a count $x/y$ and a problem-clustered bootstrap $95\%$ CI; both are stable across split seeds (conditional: llama $28.4/26.6/26.5/25.6$, Qwen $2.4/2.5/2.4/2.8$). The weaker proposer over-accepts an order of magnitude more than the stronger. The last column is the best-of-$12$ gold robustness of the cheap- vs.\ strong-selected candidate: the strong arm's advantage is a null ($+0.0$/$+0.6$). Run with all completions, prompts, seeds, and sandbox diagnostics saved ($0$ extraction failures)}{table.caption.44}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}The Cost of Verification}{23}{subsection.5.1}\protected@file@percent }
\newlabel{sec:cost}{{5.1}{23}{The Cost of Verification}{subsection.5.1}{}}
\@writefile{toc}{\contentsline {paragraph}{Cascade cost is set by the gold \emph  {invocation} rate, not the gold acceptance rate.}{23}{section*.45}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Correct (invocation-gated) cascade cost. The gold rung is invoked on candidates that \emph  {pass} \ensuremath  {\mathcal  {A}_{\mathrm  {uMFE}}}{} ($P(\ensuremath  {\mathcal  {A}_{\mathrm  {uMFE}}})$), \emph  {not} on the fraction it accepts ($P(\ensuremath  {\mathcal  {A}_{\mathrm  {pfe}}})$). The cascade saves only on reject-heavy streams ($0.37\times $); on an exact-match stream, where nearly everything passes the cheap rungs, it costs $\sim \!2\times $ always-gold. (Eterna, $15$ targets $n\le 65$; the exact-match stream is the accept-heavy candidates that exact-match, reproducing Table~\ref {tab:frontier}'s $\ensuremath  {\mathcal  {A}_{\mathrm  {uMFE}}}$ survival.)}}{24}{table.caption.46}\protected@file@percent }
\newlabel{tab:cascade}{{12}{24}{Correct (invocation-gated) cascade cost. The gold rung is invoked on candidates that \emph {pass} \umfe {} ($P(\umfe )$), \emph {not} on the fraction it accepts ($P(\pfe )$). The cascade saves only on reject-heavy streams ($0.37\times $); on an exact-match stream, where nearly everything passes the cheap rungs, it costs $\sim \!2\times $ always-gold. (Eterna, $15$ targets $n\le 65$; the exact-match stream is the accept-heavy candidates that exact-match, reproducing Table~\ref {tab:frontier}'s $\umfe $ survival.)}{table.caption.46}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Sound and Risk-Calibrated Routing}{24}{subsection.5.2}\protected@file@percent }
\newlabel{sec:routing}{{5.2}{24}{Sound and Risk-Calibrated Routing}{subsection.5.2}{}}
\@writefile{toc}{\contentsline {paragraph}{A sound cascade.}{24}{section*.50}\protected@file@percent }
\newlabel{prop:cascade}{{1}{24}{Sound cascade, $\epsilon =0$}{proposition.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Verification cost per rung. (a)~RNA: the strictness rungs' \emph  {measured} wall time scales as $\sim n^{2.8}$ within $\sim 3$--$4\times $ standalone on these instances (empirical scaling, not a worst-case guarantee---\ensuremath  {\mathcal  {A}_{\mathrm  {uMFE}}}{}'s co-optimal enumeration is not provably polynomial, App.~\ref {app:methods}); the pKiss/ProbKnot cross-oracle branch rises with $n$ but stays sub-second. (b)~SAT: the within-domain robustness ladder is steeper (higher complexity).}}{25}{figure.caption.47}\protected@file@percent }
\newlabel{fig:cost}{{9}{25}{Verification cost per rung. (a)~RNA: the strictness rungs' \emph {measured} wall time scales as $\sim n^{2.8}$ within $\sim 3$--$4\times $ standalone on these instances (empirical scaling, not a worst-case guarantee---\umfe {}'s co-optimal enumeration is not provably polynomial, App.~\ref {app:methods}); the pKiss/ProbKnot cross-oracle branch rises with $n$ but stays sub-second. (b)~SAT: the within-domain robustness ladder is steeper (higher complexity)}{figure.caption.47}{}}
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces End-to-end verification cost. Strictness within RNA is a small constant factor (shared partition-function pass); in SAT it is steep (Hamming-ball scan). The pKiss/ProbKnot branch is reported as a range at $n\le 150$ and is \emph  {not} length-matched to the RNA rungs; the only cross-oracle claim we draw is qualitative---per-call latency stays sub-second over this range yet exceeds the same-oracle rung by $>\!10\times $ at the long end---and no length-matched cross-oracle ratio is asserted.}}{25}{table.caption.49}\protected@file@percent }
\newlabel{tab:cost}{{13}{25}{End-to-end verification cost. Strictness within RNA is a small constant factor (shared partition-function pass); in SAT it is steep (Hamming-ball scan). The pKiss/ProbKnot branch is reported as a range at $n\le 150$ and is \emph {not} length-matched to the RNA rungs; the only cross-oracle claim we draw is qualitative---per-call latency stays sub-second over this range yet exceeds the same-oracle rung by $>\!10\times $ at the long end---and no length-matched cross-oracle ratio is asserted}{table.caption.49}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Cost decomposition (one machine, Intel Xeon 6776P). (a)~The strong rung's \emph  {incremental} cost given the retained cheap-oracle fold-compound object (dashed) is $66\%$ of its standalone cost---the reuse the paper appeals to is measured, not asserted (the \emph  {deployed} cascade cost is workload-dependent and given separately in Table~\ref {tab:cascade}, not here). (b)~The cross-oracle cost (pKiss, ProbKnot) rises with $n$ but stays sub-second per call over the Pseudobase range: the objective-aware oracle is $>\!10\times $ the same-oracle \ensuremath  {\mathcal  {A}_{\mathrm  {pfe}}}{} rung at the longer end ($836$ vs.\ $<70$\,ms) though sub-second per call---so the wrong-oracle failure is a \emph  {per-call} specification default, while aggregate cost at rollout scale is a separate question (\S  \ref {sec:cost}).}}{26}{figure.caption.48}\protected@file@percent }
\newlabel{fig:costdecomp}{{10}{26}{Cost decomposition (one machine, Intel Xeon 6776P). (a)~The strong rung's \emph {incremental} cost given the retained cheap-oracle fold-compound object (dashed) is $66\%$ of its standalone cost---the reuse the paper appeals to is measured, not asserted (the \emph {deployed} cascade cost is workload-dependent and given separately in Table~\ref {tab:cascade}, not here). (b)~The cross-oracle cost (pKiss, ProbKnot) rises with $n$ but stays sub-second per call over the Pseudobase range: the objective-aware oracle is $>\!10\times $ the same-oracle \pfe {} rung at the longer end ($836$ vs.\ $<70$\,ms) though sub-second per call---so the wrong-oracle failure is a \emph {per-call} specification default, while aggregate cost at rollout scale is a separate question (\S \ref {sec:cost})}{figure.caption.48}{}}
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces Sound cascade (Proposition~\ref {prop:cascade}), $15$ targets ($n\le 65$). Always exact; its saving is a reject-filter---positive only when the workload contains cheaply-rejectable candidates (reject-heavy: $12$ random $+1$ solution per target; accept-heavy: $6$ solutions, no random).}}{26}{table.caption.51}\protected@file@percent }
\newlabel{tab:routing}{{14}{26}{Sound cascade (Proposition~\ref {prop:cascade}), $15$ targets ($n\le 65$). Always exact; its saving is a reject-filter---positive only when the workload contains cheaply-rejectable candidates (reject-heavy: $12$ random $+1$ solution per target; accept-heavy: $6$ solutions, no random)}{table.caption.51}{}}
\@writefile{toc}{\contentsline {paragraph}{Risk-calibrated stopping.}{26}{section*.52}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Risk-calibrated routing (costs as a fraction of always-gold, so workload length-composition cancels). Even tolerating up to $\epsilon =0.99$ false positives, the calibrated rule cannot drop below the sound-cascade cost: on this reject-heavy workload every cheap-rung accept is a false positive ($10/10$, Clopper--Pearson upper bound $1.0$), so savings come only from cheap rejects, not cheap accepts. Empirical and workload-specific, not a general theorem.}}{27}{figure.caption.53}\protected@file@percent }
\newlabel{fig:routing}{{11}{27}{Risk-calibrated routing (costs as a fraction of always-gold, so workload length-composition cancels). Even tolerating up to $\epsilon =0.99$ false positives, the calibrated rule cannot drop below the sound-cascade cost: on this reject-heavy workload every cheap-rung accept is a false positive ($10/10$, Clopper--Pearson upper bound $1.0$), so savings come only from cheap rejects, not cheap accepts. Empirical and workload-specific, not a general theorem}{figure.caption.53}{}}
