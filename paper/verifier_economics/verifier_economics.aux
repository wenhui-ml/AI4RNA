\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Axis-1 mechanism: specification projection.} A crossing target $T$ is silently projected onto its nested skeleton by the blind MFE oracle (which cannot represent \texttt  {[]}); a design that ``solves'' the skeleton is certified even though the crossing stem the target requires never forms---a false accept in $99.6\%$ of the $251$ natural pseudoknots.}}{9}{figure.caption.12}\protected@file@percent }
\newlabel{fig:projection}{{3}{9}{\textbf {Axis-1 mechanism: specification projection.} A crossing target $T$ is silently projected onto its nested skeleton by the blind MFE oracle (which cannot represent \texttt {[]}); a design that ``solves'' the skeleton is certified even though the crossing stem the target requires never forms---a false accept in $99.6\%$ of the $251$ natural pseudoknots}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {paragraph}{The targets are solvable---it is the oracle that is blind.}{9}{section*.13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Axis~1, specification projection onto an out-of-domain oracle. (a)~Designs built against the projected skeleton are accepted by the blind harness for $250/251$ targets, flat across pseudoknot complexity. (b)~The projection erases the objective at every length and crossing-pair count; the single non-accept (green) is a target the search could not even skeleton-solve.}}{10}{figure.caption.14}\protected@file@percent }
