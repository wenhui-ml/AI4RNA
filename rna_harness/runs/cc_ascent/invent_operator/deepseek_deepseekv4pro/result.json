  "best_code": "def design(target, seed=0):\n    random.seed(seed)\n    n = len(target)\n    tp = target_pairs(target)\n    pairs = [(i, j) for i, j in tp if i < j]\n    partner = {}\n    for i, j in pairs:\n        partner[i] = j\n        partner[j] = i\n    unpaired = [i for i in range(n) if i not in partner]\n    bases = ['A', 'C', 'G', 'U']\n\n    eval_count = 0\n    max_evals = 100\n\n    def safe_eval(seq):\n        nonlocal eval_count\n        if eval_count >= max_evals:\n            return None, False\n        eval_count += 1\n        try:\n            pk = fold_pkiss_pairs(seq)\n            pb = fold_probknot_pairs(seq)\n        except BaseException:\n            return None, False\n        if pk == tp and pb == tp:\n            return (seq, 0), True\n        diff = len(pk ^ tp) + len(pb ^ tp)\n        return (seq, diff), False\n\n    # initial sequence: G-C pairs, A for unpaired\n    seq_list = ['A'] * n\n    for i, j in pairs:\n        seq_list[i] = 'G'\n        seq_list[j] = 'C'\n    seq = ''.join(seq_list)\n    res, success = safe_eval(seq)\n    if success:\n        return seq\n    best_seq = seq\n    best_diff = res[1] if res else 1e9\n\n    # try random assignments of pair types and unpaired bases\n    for _ in range(20):\n        if eval_count >= max_evals:\n            break\n        seq_list2 = ['A'] * n\n        for i, j in pairs:\n            b = random.choice(bases)\n            seq_list2[i] = b\n            seq_list2[j] = COMP[b]\n        for i in unpaired:\n            seq_list2[i] = random.choice(bases)\n        seq2 = ''.join(seq_list2)\n        res, success = safe_eval(seq2)\n        if success:\n            return seq2\n        if res and res[1] < best_diff:\n            best_diff = res[1]\n            best_seq = seq2\n\n    # mutate unpaired positions one by one\n    for i in unpaired:\n        if eval_count >= max_evals:\n            break\n        for new_base in bases:\n            if new_base == best_seq[i]:\n                continue\n            new_seq = best_seq[:i] + new_base + best_seq[i+1:]\n            res, success = safe_eval(new_seq)\n            if success:\n                return new_seq\n            if res and res[1] < best_diff:\n                best_diff = res[1]\n                best_seq = new_seq\n\n    # try swapping pair types (keep complementarity)\n    for i, j in pairs:\n        if eval_count >= max_evals:\n            break\n        old_i = best_seq[i]\n        old_j = best_seq[j]\n        for new_i in bases:\n            new_j = COMP[new_i]\n            if new_i == old_i and new_j == old_j:\n                continue\n            new_seq_list = list(best_seq)\n            new_seq_list[i] = new_i\n            new_seq_list[j] = new_j\n            new_seq = ''.join(new_seq_list)\n            res, success = safe_eval(new_seq)\n            if success:\n                return new_seq\n            if res and res[1] < best_diff:\n                best_diff = res[1]\n                best_seq = new_seq\n\n    return best_seq",
