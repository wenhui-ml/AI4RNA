  "best_code": "def design(target, seed=0):\n    n = len(target)\n    pairs = target_pairs(target)\n\n    partner = {}\n    for (i, j) in pairs:\n        partner[i] = j\n        partner[j] = i\n\n    rng = random.Random(seed)\n\n    comp_pairs = [('G', 'C'), ('C', 'G')]\n    pair_options = [('G', 'C'), ('C', 'G'), ('A', 'U'), ('U', 'A')]\n\n    def build(flip=0, unp='A'):\n        s = [unp] * n\n        for idx, (i, j) in enumerate(sorted(pairs)):\n            gc = comp_pairs[(idx + flip) % 2]\n            s[i], s[j] = gc\n        return s\n\n    def score(seqlist):\n        s = \"\".join(seqlist)\n        try:\n            p1 = fold_pkiss_pairs(s)\n        except Exception:\n            return -10 ** 6, s\n        try:\n            p2 = fold_probknot_pairs(s)\n        except Exception:\n            return -10 ** 6, s\n        if p1 == pairs and p2 == pairs:\n            return 1000000, s\n        return -(len(p1 ^ pairs) + len(p2 ^ pairs)), s\n\n    pair_list = sorted(pairs)\n    unpaired = [i for i in range(n) if i not in partner]\n\n    best_score = None\n    best_seq = None\n\n    starts = [build(0, 'A'), build(1, 'A'), build(0, 'A')]\n    for i in range(n):\n        if i not in partner:\n            starts[2][i] = 'A'\n\n    for st in starts:\n        sc, sq = score(st)\n        if best_score is None or sc > best_score:\n            best_score, best_seq = sc, sq\n        if best_score >= 1000000:\n            return best_seq\n\n    cur = list(best_seq)\n    cur_score = best_score\n\n    total_budget = 160\n    used = 0\n    stagnation = 0\n\n    while used < total_budget:\n        trial = list(cur)\n        r = rng.random()\n        if r < 0.55 and pair_list:\n            (i, j) = rng.choice(pair_list)\n            a, b = rng.choice(pair_options)\n            trial[i], trial[j] = a, b\n        elif r < 0.75 and unpaired:\n            pos = rng.choice(unpaired)\n            trial[pos] = rng.choice('ACGU')\n        elif pair_list:\n            # mutate two pairs at once\n            for _ in range(2):\n                (i, j) = rng.choice(pair_list)\n                a, b = rng.choice(pair_options)\n                trial[i], trial[j] = a, b\n        elif unpaired:\n            pos = rng.choice(unpaired)\n            trial[pos] = rng.choice('ACGU')\n\n        sc, sq = score(trial)\n        used += 1\n        if sc >= cur_score:\n            if sc > cur_score:\n                stagnation = 0\n            else:\n                stagnation += 1\n            cur = trial\n            cur_score = sc\n            if sc > best_score:\n                best_score, best_seq = sc, sq\n            if best_score >= 1000000:\n                return best_seq\n        else:\n            stagnation += 1\n\n        # restart from a fresh alternate build on stagnation\n        if stagnation >= 30:\n            stagnation = 0\n            flip = rng.randint(0, 1)\n            fresh = build(flip, 'A')\n            # randomize some unpaired\n            for k in unpaired:\n                if rng.random() < 0.3:\n                    fresh[k] = rng.choice('ACGU')\n            sc2, sq2 = score(fresh)\n            used += 1\n            cur = fresh\n            cur_score = sc2\n            if sc2 > best_score:\n                best_score, best_seq = sc2, sq2\n            if best_score >= 1000000:\n                return best_seq\n\n    return best_seq",
