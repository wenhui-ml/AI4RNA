],\n    ['G','C','C','G'],\n]\n\nloop_seq_options = [\n    'AAAGAAAAAA',\n    'AAACAAAAAA',\n    'AAAUAAAAAA',\n]\n\ncomp = {'G':'C','C':'G','A':'U','U':'A'}\n\nfor ci,(cl_start,cl_end) in enumerate(clusters):\n    # outer 10bp stem: left indices cl_start..cl_start+9, right indices cl_end-9..cl_end (but need pair mapping i with cl_end - (i-cl_start))\n    left_idxs = list(range(cl_start, cl_start+10))\n    bases = cluster_stem_bases_options[ci]\n    for k,i in enumerate(left_idxs):\n        j = cl_end - k\n        b = bases[k]\n        seq[i]=b\n        seq[j]=comp[b]\n    # unpaired after outer left stem: cl_start+10, cl_start+11 (2 nt) => '..'\n    seq[cl_start+10]='A'\n    seq[cl_start+11]='A'\n    # three hairpins\n    # hairpin1: left start = cl_start+12, 4bp stem, loop 10, stem close 4bp\n    hp_positions = []\n    pos = cl_start+12\n    for hp in range(3):\n        left4 = list(range(pos,pos+4))\n        loop10 = list(range(pos+4,pos+14))\n        right4 = list(range(pos+14,pos+18))\n        hp_positions.append((left4,loop10,right4))\n        pos = pos+18+2  # +2 unpaired after this hairpin (except last)\n    # fill hairpins\n    for hp,(left4,loop10,right4) in enumerate(hp_positions):\n        hbases = hairpin_stem_bases_options[hp]\n        for k,i in enumerate(left4):\n            j = right4[3-k]\n            b = hbases[k]\n            seq[i]=b\n            seq[j]=comp[b]\n        loopseq = loop_seq_options[hp]\n        for k,i in enumerate(loop10):\n            seq[i]=loopseq[k]\n    # unpaired between hairpins (2nt) and before closing outer right stem (2nt)\n    # positions: after hp0 right4 end -> 2 unpaired, after hp1 right4 end -> 2 unpaired, after hp2 right4 end -> 2 unpaired then outer right stem\n    # compute based on hp_positions right4 ends\n    for hp in range(3):\n        right4 = hp_positions[hp][2]\n        after_start = right4[-1]+1\n        seq[after_start]='A'\n        seq[after_start+1]='A'\n\n# fill remaining unpaired\nfor i,b in unpair