# openclaude_rna: experiment logs + run data are versioned PER-BRANCH.
# Ignore everything under runs/ EXCEPT this paper's own archived subtrees, so
# this branch tracks ONLY its own runs and other papers' runs never leak in.
# Each paper's branch whitelists its own run dirs the same way.
rna_harness/runs/*
!rna_harness/runs/cc_ascent
!rna_harness/runs/cc_pilot
!rna_harness/runs/ceiling
tsconfig.rna.json
